`timescale 1 ps/ 1 ps

module MIPS (
	Clock,
	enter,
	in,
	reset,
	display,
	LED_Input,
	LED_Input2,
	instruction,
	ALU_Result,
	halt,
	imprime_saida,
	Ativa_PC,
	saida_ff,
	entrada_ff,
	Read_Data2,
	Read_Data,
	Write_Data,
	Read_Data1,
	Write_register,
	RegDst,
	MemWrite,
	MemRead,
	ledtest);
input 	Clock;
input 	enter;
input 	[15:0] in;
input 	reset;
output 	[55:0] display;
output 	LED_Input;
output 	LED_Input2;
output 	[31:0] instruction;
output 	[31:0] ALU_Result;
output 	halt;
output 	[31:0] imprime_saida;
output 	Ativa_PC;
output 	saida_ff;
output 	entrada_ff;
output 	[31:0] Read_Data2;
output 	[31:0] Read_Data;
output 	[31:0] Write_Data;
output 	[31:0] Read_Data1;
output 	[5:0] Write_register;
output 	[1:0] RegDst;
output 	MemWrite;
output 	MemRead;
output 	ledtest;

